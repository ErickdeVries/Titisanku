{
  "expo": {
    "name": "Titisanku",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.titisanku.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Add family member photos to their profiles",
        "NSCameraUsageDescription": "Scan invite QR codes to join family trees"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#12275C"
      },
      "package": "com.titisanku.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#12275C"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "@react-native-vector-icons/feather",
      [
        "expo-image-picker",
        {
          "photosPermission": "Add family member photos to their profiles"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/ding.wav"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan invite QR codes to join family trees"
        }
      ],
      "expo-audio",
      "expo-iap",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
