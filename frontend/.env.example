# ---------------------------------------------------------------------------
# Titisanku — contoh konfigurasi frontend (Expo)
# Salin menjadi frontend/.env lalu isi nilainya.
# Variabel harus berprefix EXPO_PUBLIC_ agar ikut ter-bundle ke aplikasi.
# ---------------------------------------------------------------------------

# Alamat backend (tanpa garis miring di akhir)
EXPO_PUBLIC_BACKEND_URL=https://titisanku.helipod.app

# Firebase web config — ambil dari Firebase Console > Project settings > Your apps
# PENTING: project_id/APP_ID di sini HARUS sama dengan google-services.json (Android).
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=titisanku.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=titisanku
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=titisanku.firebasestorage.app
EXPO_PUBLIC_FIREBASE_APP_ID=1:389393525285:web:xxxxxxxxxxxxxxxxxxxxxx

# OAuth Web Client ID (dipakai Google Sign-In di Android/iOS) — WAJIB diisi,
# ambil dari Firebase Console > Authentication > Google > Web SDK configuration.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=389393525285-xxxxxxxx.apps.googleusercontent.com

# Tombol 'Masuk sebagai akun demo' di halaman login (untuk review Play)
EXPO_PUBLIC_ENABLE_DEMO_LOGIN=true

# --- Apple In-App Purchase (iOS) ------------------------------------------
# Opsional. Bila kosong, dipakai default di src/billing.ts:
#   pro    -> com.titisanku.pro.yearly
#   family -> com.titisanku.family.yearly
# Nilai harus SAMA dengan APPLE_PRO_PRODUCT_ID / APPLE_FAMILY_PRODUCT_ID di
# backend/.env, dan sama dengan produk yang didaftarkan di App Store Connect.
# EXPO_PUBLIC_IOS_PRO_PRODUCT_ID=com.titisanku.pro.yearly
# EXPO_PUBLIC_IOS_FAMILY_PRODUCT_ID=com.titisanku.family.yearly
