# ---------------------------------------------------------------------------
# Titisanku — contoh konfigurasi backend
# Salin menjadi backend/.env lalu isi nilainya.
# ---------------------------------------------------------------------------

# --- Database (MongoDB Atlas) ---------------------------------------------
# Gunakan SRV URI dari Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=titisanku

# --- Firebase Auth & Storage ----------------------------------------------
# Project ID Firebase (mis. kulproy-app)
FIREBASE_PROJECT_ID=kulproy-app
# Nama bucket Storage (mis. kulproy-app.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=kulproy-app.firebasestorage.app
# Path file service account JSON (untuk server/docker: mount sebagai file)
FIREBASE_SERVICE_ACCOUNT_JSON=/run/secrets/firebase-service-account.json
# Alternatif: isi JSON service account langsung (aman untuk PaaS yang tak bisa mount file)
# FIREBASE_SERVICE_ACCOUNT_JSON_INLINE={"type":"service_account",...}

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Titisanku

# --- Pembayaran (Midtrans) -------------------------------------------------
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# --- Aplikasi --------------------------------------------------------------
SUPERADMIN_EMAILS=email-anda@gmail.com

# --- Demo login (reviewer Play) --------------------------------------------
# Aktifkan agar tombol 'Masuk sebagai akun demo' berfungsi; matikan di production bila perlu.
DEMO_LOGIN_ENABLED=false
DEMO_PASSWORD=ubah-password-demo

# --- Google Play Billing --------------------------------------------------
PLAY_PACKAGE_NAME=com.titisanku.app

# --- Apple: Sign in with Apple & In-App Purchase --------------------------
# Semua opsional. Bila kosong, endpoint Apple mengembalikan 503 dan fitur
# Apple tidak aktif; Android/Play tetap berjalan normal.

# Bundle ID aplikasi iOS. Wajib untuk verifikasi JWS StoreKit.
# Tanpa ini `apple_jws_configured()` false -> POST /api/payments/apple/verify gagal.
APPLE_BUNDLE_ID=com.titisanku.app

# Product ID langganan yang didaftarkan di App Store Connect.
# Harus sama dengan APPLE_PRODUCTS di frontend/src/billing.ts.
APPLE_PRO_PRODUCT_ID=com.titisanku.pro.yearly
APPLE_FAMILY_PRODUCT_ID=com.titisanku.family.yearly

# App Store Server API (opsional). Dipakai untuk menanyakan status langganan.
# Diperoleh dari App Store Connect > Users and Access > Integrations >
# In-App Purchase Key (file .p8 hanya bisa diunduh SEKALI).
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# Isi salah satu: path file .p8, atau isi PEM-nya langsung (untuk PaaS).
APPLE_PRIVATE_KEY_PATH=
# APPLE_PRIVATE_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Lingkungan App Store Server API: sandbox | production
APPLE_ENVIRONMENT=sandbox
